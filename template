- name: Create StorageGRID tenant and user
  hosts: localhost
  gather_facts: false

  vars_prompt:
    - name: grid_addr
      prompt: "Grid admin address"
      default: "192.168.4.230"
      private: no
    - name: grid_user
      prompt: "Grid admin username"
      default: "root"
      private: no
    - name: grid_pass
      prompt: "Grid admin password"
      private: yes
    - name: tenant_name
      prompt: "Tenant name"
      private: no
    - name: tenant_root_pass
      prompt: "Tenant root password"
      private: yes
    - name: tenant_user_name
      prompt: "Tenant local username to create"
      default: "user1"
      private: no
    - name: tenant_user_pass
      prompt: "Tenant user password"
      private: yes

  tasks:
    - name: Get grid admin token
      ansible.builtin.uri:
        url: "https://{{ grid_addr }}/api/v3/authorize"
        method: POST
        body_format: json
        body:
          username: "{{ grid_user }}"
          password: "{{ grid_pass }}"
          cookie: false
          csrfToken: false
        headers:
          Content-Type: "application/json"
        validate_certs: false
        status_code: 200
      register: auth

    - name: Set grid token
      ansible.builtin.set_fact:
        grid_token: "{{ auth.json.data }}"

    - name: Create tenant
      ansible.builtin.uri:
        url: "https://{{ grid_addr }}/api/v3/grid/accounts"
        method: POST
        body_format: json
        body:
          name: "{{ tenant_name }}"
          password: "{{ tenant_root_pass }}"
        headers:
          Authorization: "Bearer {{ grid_token }}"
          Content-Type: "application/json"
        validate_certs: false
        status_code: 201
      register: tenant

    - name: Save tenant ID
      ansible.builtin.set_fact:
        tenant_id: "{{ tenant.json.data.id }}"

    - name: Get tenant token (root user)
      ansible.builtin.uri:
        url: "https://{{ grid_addr }}/api/v3/authorize"
        method: POST
        body_format: json
        body:
          accountId: "{{ tenant_id }}"
          username: "root"
          password: "{{ tenant_root_pass }}"
          cookie: false
          csrfToken: false
        headers:
          Content-Type: "application/json"
        validate_certs: false
        status_code: 200
      register: tenant_auth

    - name: Set tenant token
      ansible.builtin.set_fact:
        tenant_token: "{{ tenant_auth.json.data }}"

    - name: Create tenant local user
      ansible.builtin.uri:
        url: "https://{{ grid_addr }}/api/v3/tenant/users"
        method: POST
        body_format: json
        body:
          fullName: "{{ tenant_user_name }}"
          uniqueName: "{{ tenant_user_name }}"
          password: "{{ tenant_user_pass }}"
          # adjust fields if your version expects different keys
        headers:
          Authorization: "Bearer {{ tenant_token }}"
          Content-Type: "application/json"
        validate_certs: false
        status_code: 201
      register: tenant_user

